package mega

import "core:os"
import "core:flags"
import "core:fmt"
import main "project:src"
import meta "project:meta"
import configen "project:config_generator"

Options :: struct {
    gencode: bool,
    mkconfig: bool,
    rdconfig: bool,
    run: bool,
}

main :: proc() {
    opt: Options
    flags.parse_or_exit(&opt, os.args)

    opt2: Options

    if opt == opt2 {
        fmt.println("usage: ")
        fmt.println("odin run . -debug -collection:project=. -- -<flagname>")
        fmt.println()
        fmt.println("mkconfig - generates a config file (prints it out for demo for now)")
        fmt.println("run - runs the editor (the most interesting part!)")
        fmt.println("rdconfig - reads a generated config (was working will fix however low priority)")
        fmt.println("gencode - generates the UI widgets (you can delete the files under ./src/*.widget.odin as those are generated by this")
    }

    if opt.gencode {
        meta.main()
    }

    if opt.run {
        main.prog_main()
    }
    
    if opt.mkconfig {
        configen.output_main()
    }

    if opt.rdconfig {
        configen.input_main()
    }
}

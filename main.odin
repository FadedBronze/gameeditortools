package build

import "core:os"
import "core:flags"
import "core:fmt"
import meta "project:meta"

Options :: struct {
    gencode: bool,
    //mkconfig: bool,
    //rdconfig: bool,
    run: bool,
    debug: bool,
    build: bool,
}

main :: proc() {
    opt: Options
    flags.parse_or_exit(&opt, os.args)

    opt2: Options

    if opt == opt2 {
        fmt.println("usage: ")
        fmt.println("odin run . -debug -collection:project=. -- -<flagname>")
        fmt.println()
        fmt.println("mkconfig - generates a config file (prints it out for demo for now)")
        fmt.println("run - runs the editor (the most interesting part!)")
        fmt.println("rdconfig - reads a generated config (was working will fix however low priority)")
        fmt.println("gencode - generates the UI widgets (you can delete the files under ./src/*.widget.odin as those are generated by this")
    }

    if opt.gencode {
        meta.main()
    }

    if opt.run || opt.build {
        commands: [][]string = {
            opt.build ? {"odin", "build", "../src", "-out:editor", "-collection:project=../", opt.debug ? "-debug" : ""} : {},
            opt.run ? {"./editor"} : {}
        }

        os.change_directory("./environment/")

        for command in commands {
            if len(command) == 0 {
                continue
            }

            desc := os.Process_Desc {
                command = command,
                stdout = os.stdout,
                stderr = os.stderr,
            }

            p, err := os.process_start(desc)
            if err != nil {
                fmt.println("[BUILD] command failed with: ", err)
            }

            state, wait_err := os.process_wait(p)
            if wait_err != nil {
                fmt.println("[BUILD] project wait error: ", wait_err)
            }
            
            fmt.printfln("[COMMAND_EXIT] %v", state.exit_code)
            if state.exit_code == 1 {
                break;
            }
        }
    }

    // will remove these eventually since they only serve testers
    
    //if opt.mkconfig {
    //    configen.output_main()
    //}

    //if opt.rdconfig {
    //    configen.input_main()
    //}
}
